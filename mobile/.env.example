# Copy this file to .env and set the address of your backend.
#
# iOS simulator:      http://localhost:4000
# Android emulator:   http://10.0.2.2:4000
# Real phone (Expo Go on the same Wi-Fi): http://<your-computer-LAN-IP>:4000
#   Find your IP on macOS with:  ipconfig getifaddr en0
#
# If this is not set, the app uses localhost (iOS) or 10.0.2.2 (Android).
EXPO_PUBLIC_API_URL=http://localhost:4000
