# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Port the API server listens on
PORT=4000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://miniledger_user:change_me@localhost:5432/miniledger

# Secret used to sign login tokens. Use a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# How long a login token stays valid (examples: 7d, 12h)
JWT_EXPIRES_IN=7d

# Timezone used to decide what "today" is when checking overdue loans
APP_TIMEZONE=Asia/Kolkata

# Optional: a separate, empty database used only by the integration tests.
# The tests DELETE all rows in it, so never point this at real data.
# TEST_DATABASE_URL=postgres://miniledger_user:change_me@localhost:5432/miniledger_test
